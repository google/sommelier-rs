[Unit]
Description=Sommelier Wayland proxy for virtio-wl
Documentation=https://github.com/google/sommelier-rs

[Service]
Type=simple
ExecStart=%h/.local/bin/sommelier-rs --virtio-wl /dev/wl0 wayland-0
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
